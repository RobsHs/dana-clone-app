<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.DanaClone" parent="Theme.Material3.Light.NoActionBar">
        <!-- Status Bar & Nav Bar -->
        <item name="android:statusBarColor">@color/dana_blue</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Brand Colors -->
        <item name="colorPrimary">@color/dana_blue</item>
        <item name="colorPrimaryContainer">@color/dana_blue_light</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/dana_blue_dark</item>
        <item name="android:windowBackground">@color/bg_page</item>
    </style>
</resources>
